#!/usr/bin/env bash
# Benchtop ELN launcher.  Usage: ./benchtop [start|backup|backups|restore FILE|seed|help]
# Works with the bash that ships with macOS (3.2).
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BACKEND="$ROOT/backend"
FRONTEND="$ROOT/frontend"
VENV="$BACKEND/.venv"
PORT="${BENCHTOP_PORT:-8000}"
export BENCHTOP_DATA_DIR="${BENCHTOP_DATA_DIR:-$BACKEND/data}"
export BENCHTOP_STATIC_DIR="${BENCHTOP_STATIC_DIR:-$FRONTEND/dist}"

say()  { printf '\033[1m%s\033[0m\n' "$*"; }
fail() { printf '\033[31m%s\033[0m\n' "$*" >&2; exit 1; }

find_python() {
  for c in python3.15 python3.14 python3.13 python3.12 python3.11 python3; do
    if command -v "$c" >/dev/null 2>&1 &&
       "$c" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 11) else 1)' 2>/dev/null; then
      echo "$c"; return 0
    fi
  done
  return 1
}

ensure_python_env() {
  if [ -x "$VENV/bin/python" ] && ! "$VENV/bin/python" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 11) else 1)' 2>/dev/null; then
    say "Existing environment uses an old Python; rebuilding it."
    rm -rf "$VENV"
  fi
  if [ ! -x "$VENV/bin/python" ]; then
    PY="$(find_python)" || fail "Benchtop needs Python 3.11 or newer. Install it from https://www.python.org/downloads/ and run this again."
    say "Setting up Python environment with $($PY --version)…"
    "$PY" -m venv "$VENV"
  fi
  local stamp="$VENV/.requirements-installed"
  if [ ! -f "$stamp" ] || [ "$BACKEND/requirements.txt" -nt "$stamp" ]; then
    say "Installing Python packages (first run takes a minute or two)…"
    "$VENV/bin/python" -m pip install --quiet --upgrade pip
    "$VENV/bin/python" -m pip install --quiet -r "$BACKEND/requirements.txt"
    touch "$stamp"
  fi
}

ui_is_stale() {
  [ ! -f "$BENCHTOP_STATIC_DIR/index.html" ] && return 0
  [ -n "$(find "$FRONTEND/src" "$FRONTEND/package.json" -newer "$BENCHTOP_STATIC_DIR/index.html" -print -quit 2>/dev/null)" ]
}

ensure_ui() {
  ui_is_stale || return 0
  if command -v npm >/dev/null 2>&1; then
    say "Building the web interface…"
    ( cd "$FRONTEND" && { [ -d node_modules ] && [ node_modules -nt package-lock.json ] || npm install --no-audit --no-fund --loglevel=error; } && npm run build --silent )
  elif [ -f "$BENCHTOP_STATIC_DIR/index.html" ]; then
    say "Web interface sources changed but Node isn't installed; using the existing build."
  else
    fail "The web interface isn't built and Node isn't installed. Install Node from https://nodejs.org (LTS) and run this again."
  fi
}

running() { curl -fsS "http://127.0.0.1:$PORT/api/health" >/dev/null 2>&1; }

open_browser() {
  local url="http://localhost:$PORT"
  if command -v open >/dev/null 2>&1; then open "$url"
  elif command -v xdg-open >/dev/null 2>&1; then xdg-open "$url" >/dev/null 2>&1
  else echo "Open $url in your browser."; fi
}

py() { ( cd "$BACKEND" && "$VENV/bin/python" "$@" ); }

wait_up() { for _ in $(seq 1 80); do running && return 0; sleep 0.5; done; return 1; }

# Version 0.5 could register Benchtop as a login item. That option has been removed; if it was
# used, take the login item away so nothing starts Benchtop behind the user's back.
remove_old_login_item() {
  local plist="$HOME/Library/LaunchAgents/org.benchtop.eln.plist"
  [ "$(uname -s)" = "Darwin" ] && [ -f "$plist" ] || return 0
  launchctl bootout "gui/$(id -u)/org.benchtop.eln" 2>/dev/null || true
  rm -f "$plist"
  say "Removed the old start-at-login setting; Benchtop now only runs when you open it."
}

cmd="${1:-start}"
case "$cmd" in
  start)
    remove_old_login_item
    if running; then say "Benchtop is already running."; open_browser; exit 0; fi
    ensure_python_env
    ensure_ui
    say "Starting Benchtop on http://localhost:$PORT  (data: $BENCHTOP_DATA_DIR)"
    say "Leave this window open while you work. Close it or press Ctrl+C to stop."
    ( wait_up && open_browser ) &
    cd "$BACKEND" && exec "$VENV/bin/python" -m uvicorn app.main:app --host 127.0.0.1 --port "$PORT"
    ;;

  status)
    v="$(curl -fsS "http://127.0.0.1:$PORT/api/health" 2>/dev/null | sed -E 's/.*"version":"([^"]+)".*/\1/' || true)"
    if [ -n "$v" ]; then say "Running: version $v at http://localhost:$PORT"; else say "Not running."; fi
    echo "Folder: $ROOT"
    echo "Data:   $BENCHTOP_DATA_DIR"
    ;;

  upgrade)
    ZIP="${2:-}"
    { [ -n "$ZIP" ] && [ -f "$ZIP" ]; } || fail "Usage: ./benchtop upgrade ~/Downloads/benchtop-eln-vX.Y.zip"
    running && fail "Stop Benchtop first (close its Terminal window or press Ctrl+C there), then run upgrade again."
    TMP="$(mktemp -d)"
    trap 'rm -rf "$TMP"' EXIT
    unzip -q "$ZIP" -d "$TMP" || fail "Couldn't unpack $ZIP"
    NEW="$TMP/benchtop"
    { [ -f "$NEW/benchtop" ] && [ -d "$NEW/backend/app" ]; } || fail "$ZIP doesn't look like a Benchtop release."
    NEWV="$(sed -nE 's/^__version__ = "([^"]+)".*/\1/p' "$NEW/backend/app/__init__.py")"
    OLDV="$(sed -nE 's/^__version__ = "([^"]+)".*/\1/p' "$BACKEND/app/__init__.py")"
    say "Upgrading Benchtop $OLDV -> $NEWV"
    if [ -x "$VENV/bin/python" ] && [ -f "$BENCHTOP_DATA_DIR/benchtop.db" ]; then
      say "Backing up your data first…"; py -m app.backup create || fail "Backup failed, so nothing was changed."
    fi
    # replace program files; keep data, the Python environment and node_modules
    rsync -a --delete --exclude '/backend/data/' --exclude '/backend/.venv/' --exclude '/frontend/node_modules/' "$NEW/" "$ROOT/"
    chmod +x "$ROOT/benchtop" "$ROOT/Benchtop.command" 2>/dev/null || true
    remove_old_login_item
    say "Upgraded to $NEWV. Start it with ./benchtop"
    ;;

  backup)   ensure_python_env; py -m app.backup create ;;
  backups)  ensure_python_env; py -m app.backup list ;;
  restore)
    [ $# -ge 2 ] || fail "Usage: ./benchtop restore path/to/benchtop-backup-….zip"
    running && fail "Stop Benchtop first (close its Terminal window or press Ctrl+C there), then run restore."
    ensure_python_env; py -m app.backup restore "$2"
    ;;
  seed)     ensure_python_env; py -m app.seed ;;
  export-obsidian)
    [ $# -ge 2 ] || fail "Usage: ./benchtop export-obsidian /path/to/YourVault/Benchtop"
    ensure_python_env; py -m app.export_md "$2" ;;
  help|-h|--help)
    cat <<'HELP'
Benchtop ELN

Everyday
  ./benchtop              start Benchtop and open your browser (close the window or Ctrl+C to stop)
  ./benchtop status       is it running, which version, where is the data
  ./benchtop upgrade ZIP  install a new version from its zip (backs up first, keeps your data)

Data
  ./benchtop backup       make a backup now
  ./benchtop backups      list backups
  ./benchtop restore F    restore backup file F (your current data is moved aside, not deleted)
  ./benchtop seed         load demo data
  ./benchtop export-obsidian DIR   write every experiment as a Markdown note into DIR

Settings (environment variables)
  BENCHTOP_PORT=8000                 port to listen on
  BENCHTOP_DATA_DIR=backend/data     where the database and attachments live
  BENCHTOP_BACKUP_DIR=…              where backups go (e.g. a folder in iCloud Drive)
  BENCHTOP_BACKUP_KEEP=14            how many backups to keep
  BENCHTOP_OBSIDIAN_DIR=…            sync notes into this vault folder every hour while running
HELP
    ;;
  *) fail "Unknown command '$cmd'. Try ./benchtop help" ;;
esac
