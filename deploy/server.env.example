# Copy to deploy/.env and fill in. Keep it private (it holds passwords).

# The address people will type, pointed at this server in DNS
BENCHTOP_DOMAIN=eln.example-lab.ca

# A long random value: generate it with   openssl rand -hex 32
BENCHTOP_SECRET_KEY=change-me
# Only used for the first sign-in; Benchtop then asks you to create your own admin account
BENCHTOP_ADMIN_PASSWORD=change-me

# Where the daily backups land on the server
BENCHTOP_BACKUP_HOST_DIR=./backups
# The second copy: a folder on another disk or a network drive (NAS), so one failure can't take both.
# After the first start, choose /backup-copy in Admin → Backups.
BENCHTOP_BACKUP_COPY_HOST_DIR=./backup-copy

# ---- Single sign-on (optional). Register Benchtop with your provider using the redirect URI
#      https://<BENCHTOP_DOMAIN>/api/auth/sso/callback
# Microsoft 365 / Entra ID (most universities):  https://login.microsoftonline.com/<tenant id>/v2.0
# Google Workspace:                              https://accounts.google.com
BENCHTOP_OIDC_ISSUER=
BENCHTOP_OIDC_CLIENT_ID=
BENCHTOP_OIDC_CLIENT_SECRET=
# Button label (guessed from the issuer if empty), e.g. "UTORid" or "Microsoft"
BENCHTOP_OIDC_NAME=
# Only let these email domains in (comma-separated), e.g. utoronto.ca,mail.utoronto.ca
BENCHTOP_OIDC_ALLOWED_DOMAINS=
# on: first sign-in creates an account (as a scientist). off: an admin must add people first (matched by email)
BENCHTOP_OIDC_AUTO_CREATE=on
# off: only single sign-on (admins can still use a password, in case the provider is down)
BENCHTOP_PASSWORD_LOGIN=on
